---
import "./Hero.sass";
---

<section class="section hero" aria-labelledby="hero__header">
  <h1 id="hero__header" class="hero__header">
    مونگو کرفت، سرور MMORPG ماینکرفت
  </h1>
  <p class="hero__description">
    از بین کلاس های ما یکی رو انتخاب کن، به نبرد با ماب های مختلف برو وسایل جدید
    به دست بیار، خودتو ارتقاء بده و داستان مونگو رو کامل کن. همین الان برای ثبت
    نام در نسخه ی ازمایشی ثبت نام کن.
  </p>
  <div class="hero__cta">
    <button id="btn-register" class="button">
      ثبت نام
    </button>
    <button class="button">آموزشات</button>
    <button class="button">کانال تلگرام</button>
  </div>
</section>

<script>
  const registerBtn = document.getElementById("btn-register");
  registerBtn?.addEventListener("click", (e) => {
    alert("ok");
  });
</script>
